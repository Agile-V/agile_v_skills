{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agile-v.org/schemas/RISK_ASSESSMENT.schema.json","title":"Risk assessment v2 (dimension-based classification with floors)","type":"object","required":["schema_version","compatibility","migration","fixture_owner","risk_assessment"],"properties":{"schema_version":{"const":"1.0"},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1},"fixture_owner":{"type":"string","minLength":1},"risk_assessment":{"type":"object","required":["id","task_id","dimensions","floors","selected_level","rationale"],"properties":{"id":{"pattern":"^RA-[A-Z0-9-]+$"},"task_id":{"type":"string","minLength":1},"dimensions":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","required":["score"],"properties":{"score":{"type":"integer","minimum":1,"maximum":4},"rationale":{"type":"string"}},"additionalProperties":true}},"floors":{"type":"array","items":{"type":"object","required":["reason","minimum_level"],"properties":{"reason":{"type":"string","minLength":1},"minimum_level":{"enum":["L0","L1","L2","L3","L4"]}},"additionalProperties":true}},"selected_level":{"enum":["L0","L1","L2","L3","L4"]},"rationale":{"type":"string","minLength":1},"exception_ref":{"pattern":"^EXC-[A-Z0-9-]+$"}},"additionalProperties":true}},"additionalProperties":false}
