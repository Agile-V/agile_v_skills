{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agile-v.org/schemas/QUALIFICATION_DEVIATION.schema.json","title":"Qualification deviation","type":"object","required":["schema_version","compatibility","migration","fixture_owner","deviation"],"properties":{"schema_version":{"const":"1.0"},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1},"fixture_owner":{"type":"string","minLength":1},"deviation":{"type":"object","required":["deviation_id","stage","subject_ref","baseline_ref","what_differed","detected_at","impact_assessment","disposition"],"properties":{"deviation_id":{"type":"string","pattern":"^QDEV-[A-Z0-9-]+$"},"protocol_ref":{"type":"string"},"execution_ref":{"type":"string"},"stage":{"enum":["DQ","IQ","IOQ","OQ","PQ"]},"subject_ref":{"type":"string","minLength":1},"baseline_ref":{"type":"string","minLength":1},"what_differed":{"type":"string","minLength":1},"detected_at":{"type":"string","minLength":1},"immediate_containment":{"type":"string"},"impact_assessment":{"type":"object","required":["product_quality","patient_safety","data_integrity","intended_use"],"properties":{"product_quality":{"type":"string","minLength":1},"patient_safety":{"type":"string","minLength":1},"data_integrity":{"type":"string","minLength":1},"intended_use":{"type":"string","minLength":1}},"additionalProperties":true},"root_cause":{"type":"string"},"corrective_action":{"type":"string"},"retest_required":{"type":"boolean"},"affected_evidence_scope":{"type":"array","items":{"type":"string"}},"disposition":{"type":"object","required":["decision","approver_ref"],"properties":{"decision":{"enum":["open","accepted","rejected","closed","capa_raised"]},"approver_ref":{"type":"string","minLength":1},"closure_evidence_ref":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":false}
