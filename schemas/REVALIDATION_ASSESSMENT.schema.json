{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agile-v.org/schemas/REVALIDATION_ASSESSMENT.schema.json","title":"Change-aware revalidation assessment","type":"object","required":["schema_version","compatibility","migration","fixture_owner","assessment"],"properties":{"schema_version":{"const":"1.1"},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1},"fixture_owner":{"type":"string","minLength":1},"assessment":{"type":"object","required":["id","task_id","evaluated_at","changed_refs","evaluations","coverage"],"properties":{"id":{"pattern":"^REVAL-[A-Z0-9-]+$"},"task_id":{"type":"string","minLength":1},"evaluated_at":{"format":"date-time"},"changed_refs":{"type":"array","minItems":1,"items":{"type":"object","required":["kind","ref"],"properties":{"kind":{"enum":["source","requirement","policy","environment","tool","model","hardware"]},"ref":{"type":"string","minLength":1}},"additionalProperties":true}},"evaluations":{"type":"array","minItems":1,"items":{"type":"object","required":["evidence_ref","claim_refs","result"],"properties":{"evidence_ref":{"pattern":"^EVI-[A-Z0-9-]+$"},"claim_refs":{"type":"array","minItems":1,"items":{"pattern":"^CLM-[A-Z0-9-]+$"}},"result":{"enum":["UNCHANGED","REVALIDATION_REQUIRED","STALE","UNKNOWN"]},"rationale":{"type":"string"}},"additionalProperties":true}},"coverage":{"enum":["complete","partial","unknown"]},"conservative_fallback_applied":{"type":"boolean"},"risk_level":{"enum":["L0","L1","L2","L3","L4"]}},"additionalProperties":true,"allOf":[{"if":{"properties":{"coverage":{"enum":["unknown","partial"]}},"required":["coverage"]},"then":{"required":["conservative_fallback_applied"],"properties":{"conservative_fallback_applied":{"const":true}}}}]}},"additionalProperties":false}
