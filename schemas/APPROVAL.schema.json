{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agile-v.org/schemas/APPROVAL.schema.json","title":"Approval","type":"object","required":["schema_version","compatibility","migration","fixture_owner","approval"],"properties":{"schema_version":{"const":"1.0"},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1},"fixture_owner":{"type":"string","minLength":1},"approval":{"type":"object","required":["id","approver","authority","operation","diff_digest","scope","expires_at","decision"],"properties":{"id":{"pattern":"^APR-[A-Z0-9-]+$"},"approver":{"type":"string","minLength":1},"authority":{"type":"string","minLength":1},"operation":{"type":"string","minLength":1},"diff_digest":{"pattern":"^[a-f0-9]{64}$"},"scope":{"type":"string","minLength":1},"expires_at":{"format":"date-time"},"decision":{"enum":["approved","rejected","expired"]}},"additionalProperties":true}},"additionalProperties":false}
