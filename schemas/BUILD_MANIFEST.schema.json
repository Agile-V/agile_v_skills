{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-v.org/schemas/BUILD_MANIFEST.schema.json",
  "title": "Agile-V build manifest",
  "type": "object",
  "required": ["manifest_id", "artifacts"],
  "properties": {
    "manifest_id": {"type": "string", "pattern": "^BM-[A-Z0-9-]+$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "requirement_id", "requirement_revision", "baseline_id", "relation", "path", "notes"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^ART-[A-Z0-9.-]+$"},
          "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
          "requirement_revision": {"type": "string", "minLength": 1},
          "baseline_id": {"type": "string", "minLength": 1},
          "relation": {"const": "implements"},
          "path": {"type": "string", "minLength": 1},
          "cycle": {"type": "string", "minLength": 1},
          "change_request_id": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
