{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agile-v.org/schemas/CHECKPOINT.schema.json","title":"Checkpoint","type":"object","required":["schema_version","compatibility","migration","fixture_owner","checkpoint"],"properties":{"schema_version":{"const":"1.0"},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1},"fixture_owner":{"type":"string","minLength":1},"checkpoint":{"type":"object","required":["id","state","resume_token","approval_id","invalidation_conditions"],"properties":{"id":{"pattern":"^CHK-[A-Z0-9-]+$"},"state":{"enum":["draft","validated","approved","baselined","changed","retired","blocked"]},"resume_token":{"type":"string","minLength":1},"approval_id":{"pattern":"^APR-[A-Z0-9-]+$"},"invalidation_conditions":{"type":"array","minItems":1,"items":{"type":"string"}}},"additionalProperties":true}},"additionalProperties":false}
