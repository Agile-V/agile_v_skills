{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agile-v.org/schemas/EXCEPTION_DECISION.schema.json","title":"Exception decision (waiver, concession, dispensation, residual-risk acceptance, defer)","type":"object","required":["schema_version","compatibility","migration","fixture_owner","exception"],"properties":{"schema_version":{"const":"1.0"},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1},"fixture_owner":{"type":"string","minLength":1},"exception":{"type":"object","required":["id","type","task_id","control_or_claim_ref","rationale","scope","approver","authority_source","issued_at","expires_at","remediation_owner","target_resolution"],"properties":{"id":{"pattern":"^EXC-[A-Z0-9-]+$"},"type":{"enum":["waiver","concession","dispensation","residual_risk_acceptance","defer"]},"task_id":{"type":"string","minLength":1},"control_or_claim_ref":{"type":"string","minLength":1},"rationale":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"approver":{"type":"string","minLength":1},"authority_source":{"type":"string","minLength":1},"issued_at":{"format":"date-time"},"expires_at":{"format":"date-time"},"monitoring":{"type":["string","null"]},"remediation_owner":{"type":"string","minLength":1},"target_resolution":{"type":"string","minLength":1},"evidence_refs":{"type":"array","items":{"type":"string"}},"non_waivable":{"type":"boolean","default":false}},"additionalProperties":true,"allOf":[{"if":{"properties":{"type":{"enum":["dispensation","residual_risk_acceptance"]}},"required":["type"]},"then":{"required":["monitoring"],"properties":{"monitoring":{"type":"string","minLength":1}}}}]}},"additionalProperties":false}
