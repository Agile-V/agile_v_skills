{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agile-v.org/schemas/VALIDATION_REPORT.schema.json","title":"Validation report","type":"object","required":["schema_version","compatibility","migration","fixture_owner","report"],"properties":{"schema_version":{"const":"1.0"},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1},"fixture_owner":{"type":"string","minLength":1},"report":{"type":"object","required":["id","intended_use","users","environment","protocol","deviations","acceptance"],"properties":{"id":{"pattern":"^VAL-[A-Z0-9-]+$"},"intended_use":{"type":"string","minLength":1},"users":{"type":"array","minItems":1,"items":{"type":"string"}},"environment":{"type":"string","minLength":1},"protocol":{"type":"string","minLength":1},"deviations":{"type":"array","items":{"type":"string"}},"acceptance":{"enum":["accepted","rejected","unknown","not_applicable"]}},"additionalProperties":true}},"additionalProperties":false}
