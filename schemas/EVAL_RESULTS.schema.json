{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-v.org/schemas/EVAL_RESULTS.schema.json",
  "title": "Agile-V evaluation results",
  "type": "object",
  "required": ["eval_run_id", "eval_timestamp", "policy_version_ref", "eval_gate_status", "eval_gate_rationale", "thresholds", "runs"],
  "properties": {
    "eval_run_id": {"type": "string", "pattern": "^ER-[A-Z0-9-]+$"},
    "eval_timestamp": {"type": "string", "format": "date-time"},
    "policy_version_ref": {"type": "string", "minLength": 1},
    "eval_gate_status": {"enum": ["PASS", "FAIL", "WAIVED"]},
    "eval_gate_rationale": {"type": "string", "minLength": 1},
    "thresholds": {
      "type": "object",
      "required": ["critical_max_fail", "major_max_fail", "minor_max_fail"],
      "properties": {
        "critical_max_fail": {"type": "integer", "minimum": 0},
        "major_max_fail": {"type": "integer", "minimum": 0},
        "minor_max_fail": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["eval_run_id", "suite_id", "mode", "pass_count", "fail_count", "threshold_met", "linked_cycle", "notes"],
        "properties": {
          "eval_run_id": {"type": "string", "pattern": "^ER-[A-Z0-9-]+$"},
          "suite_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["offline", "online", "waived"]},
          "pass_count": {"type": "integer", "minimum": 0},
          "fail_count": {"type": "integer", "minimum": 0},
          "threshold_met": {"type": "boolean"},
          "linked_cycle": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "waiver_approval_ref": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"eval_gate_status": {"const": "WAIVED"}}, "required": ["eval_gate_status"]},
      "then": {"required": ["waiver_approval_ref"]}
    }
  ],
  "additionalProperties": false
}
