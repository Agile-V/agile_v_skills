{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agile-v.org/schemas/EVIDENCE_BUNDLE.schema.json","title":"Evidence bundle","type":"object","required":["schema_version","compatibility","migration","fixture_owner","bundle"],"properties":{"schema_version":{"const":"1.0"},"compatibility":{"type":"string","minLength":1},"migration":{"type":"string","minLength":1},"fixture_owner":{"type":"string","minLength":1},"bundle":{"type":"object","required":["id","completeness","references","signatures","retention","baseline_id"],"properties":{"id":{"pattern":"^EVD-[A-Z0-9-]+$"},"completeness":{"enum":["complete","incomplete","unknown"]},"references":{"type":"array","minItems":1,"items":{"type":"string"}},"signatures":{"type":"array","items":{"type":"string"}},"retention":{"type":"string","minLength":1},"baseline_id":{"type":"string","minLength":1}},"additionalProperties":true}},"additionalProperties":false}
