{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-v.org/schemas/SOP_BINDING.schema.json",
  "title": "Agile V SOP Binding",
  "description": "Binds an organization's controlled SOPs to Agile-V controls, artifacts, and Human Gates. Authority flows SOP -> binding -> execution. Populated bindings are confidential and belong only in the organization's private repository.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "sop_framework", "source_of_truth", "owner", "bindings"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "sop_framework": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "source_of_truth": {"const": "sop"},
    "owner": {"type": "string", "minLength": 1},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id", "sop_ref", "title", "applies_to",
        "deliverables", "human_gate", "verification",
        "evidence_locator", "status", "owner"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "sop_ref": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "applies_to": {"type": "string", "minLength": 1},
        "agile_v": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "control": {"type": "string"},
            "artifact": {"type": "string"}
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "human_gate": {"type": "string", "minLength": 1},
        "verification": {"enum": ["review", "test", "trace", "inspection"]},
        "evidence_locator": {"type": "string", "minLength": 1},
        "status": {"enum": ["mapped", "gap", "not-applicable"]},
        "owner": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "mapped"}}},
          "then": {
            "required": ["agile_v"],
            "properties": {
              "agile_v": {
                "anyOf": [
                  {"required": ["control"]},
                  {"required": ["artifact"]}
                ]
              }
            }
          }
        }
      ]
    }
  }
}
