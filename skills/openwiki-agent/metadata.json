{
  "name": "openwiki-agent",
  "version": "1.0.0",
  "description": "Governs when and how an Agile-V agent consults and trusts the OpenWiki-generated repository knowledge layer (openwiki/), via the agilev wiki CLI in agentic_agile_v.",
  "category": "understanding",
  "lifecycle_position": "pre-gate-0",
  "inputs": [
    "openwiki/**",
    ".agile-v/wiki/manifest.json",
    ".agile-v/wiki/validation.json",
    ".agentic-agile-v/tasks/<task_id>/"
  ],
  "outputs": [
    "knowledge_snapshot (in evidence.json / evidence_bundle.json)"
  ],
  "output_dir": ".agentic-agile-v/tasks/<task_id>/",
  "triggers": [
    "existing codebase",
    "openwiki directory present",
    ".agile-v/wiki/manifest.json exists",
    "is the wiki up to date",
    "check the docs before you touch this",
    "what does the knowledge base say",
    "onboarding",
    "unknown architecture"
  ],
  "dependencies": [
    "agentic_agile_v: src/agilev/wiki/ (agilev wiki CLI)",
    "optional: langchain-ai/openwiki (external CLI that generates openwiki/ content)"
  ],
  "evidence_level": "supporting",
  "evidence_section": "knowledge_snapshot",
  "human_gate_required": false,
  "blocks_on_low_confidence": false,
  "compatible_frameworks": [
    "Claude Code",
    "Codex",
    "Cursor",
    "Copilot",
    "Gemini CLI",
    "OpenCode",
    "Cline"
  ],
  "next_skill": "system-understanding-agent"
}
