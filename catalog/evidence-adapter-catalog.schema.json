{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-v.org/catalog/evidence-adapter-catalog.schema.json",
  "title": "Agile-V Evidence Adapter Registry catalog (generated)",
  "description": "Generated by tools/build_evidence_adapter_catalog.py. Do not edit by hand. Digests use contracts.semantics.profile_digest over the whole profile envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "registry_contract_version", "generator", "adapters", "property_profiles"],
  "properties": {
    "$schema": {"const": "./evidence-adapter-catalog.schema.json"},
    "schema_version": {"const": "1.0"},
    "registry_contract_version": {"type": "string"},
    "generator": {"const": "tools/build_evidence_adapter_catalog.py"},
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "adapter_version", "profile_path", "profile_digest", "status", "owner", "evidence_type", "historical"],
        "properties": {
          "adapter_id": {"type": "string", "pattern": "^EAD-"},
          "adapter_version": {"type": "string"},
          "profile_path": {"type": "string", "pattern": "^profiles/evidence-sources/"},
          "profile_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "status": {"enum": ["experimental", "candidate", "stable", "deprecated"]},
          "owner": {"type": "string"},
          "evidence_type": {"type": "string"},
          "historical": {"type": "boolean"}
        }
      }
    },
    "property_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "claim_type", "risk_level", "profile_path", "profile_digest", "status", "owner"],
        "properties": {
          "profile_id": {"type": "string", "pattern": "^EVP-"},
          "claim_type": {"type": "string"},
          "risk_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
          "profile_path": {"type": "string", "pattern": "^profiles/evidence-properties/"},
          "profile_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "status": {"enum": ["experimental", "candidate", "stable", "deprecated"]},
          "owner": {"type": "string"}
        }
      }
    }
  }
}
