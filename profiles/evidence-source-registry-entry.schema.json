{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-v.org/profiles/evidence-source-registry-entry.schema.json",
  "title": "Agile-V Evidence Adapter Registry entry (registry overlay on EVIDENCE_SOURCE_PROFILE)",
  "description": "Registry-level fields every reviewed source profile must carry in addition to schemas/EVIDENCE_SOURCE_PROFILE.schema.json. Storage validity of the base schema is unchanged.",
  "type": "object",
  "required": ["adapter", "fixture_owner"],
  "properties": {
    "fixture_owner": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "required": ["adapter_id", "adapter_version", "title", "status", "owner", "evidence_type",
                   "source_version_scope", "may_establish", "may_not_establish",
                   "minimum_evidence_locators", "freshness", "known_limitations", "references",
                   "supersedes", "superseded_by", "trust_boundary"],
      "properties": {
        "adapter_id": {"type": "string", "pattern": "^EAD-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
        "adapter_version": {"type": "string", "pattern": "^[0-9]+$"},
        "title": {"type": "string", "minLength": 3},
        "status": {"enum": ["experimental", "candidate", "stable", "deprecated"]},
        "owner": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source_version_scope": {
          "type": "object",
          "required": ["tool", "format", "supported_versions"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1},
            "supported_versions": {"type": "string", "pattern": "^(\\*|(?:(?:>=|<=|==|<|>)[0-9]+(?:\\.[0-9]+)*)(?:,(?:>=|<=|==|<|>)[0-9]+(?:\\.[0-9]+)*)*)$"}
          },
          "additionalProperties": false
        },
        "may_establish": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "may_not_establish": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "minimum_evidence_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "freshness": {
          "type": "object",
          "required": ["invalidated_by", "max_age_days"],
          "properties": {
            "invalidated_by": {"type": "array", "minItems": 1, "uniqueItems": true,
                               "items": {"enum": ["source", "requirement", "policy", "environment", "tool", "model", "hardware"]}},
            "max_age_days": {"type": ["integer", "null"], "minimum": 1}
          },
          "additionalProperties": false
        },
        "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
        "references": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
        "supersedes": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "superseded_by": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "trust_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
